{
  "name": "dsh-deepseek-web",
  "version": "1.0.60",
  "description": "把 chat.deepseek.com 网页版包成 OpenAI 兼容接口的 DSH 插件：无浏览器直连、多账号、选模型自动启动、自带设置界面",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "server",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-deepseek-web": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-web",
    "openai-compatible"
  ],
  "license": "MIT",
  "author": "irerc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irerc/dsh-deepseek-web.git"
  },
  "homepage": "https://github.com/irerc/dsh-deepseek-web",
  "bugs": {
    "url": "https://github.com/irerc/dsh-deepseek-web/issues"
  }
}
